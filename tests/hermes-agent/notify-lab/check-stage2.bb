#!/usr/bin/env bb
(require '[cheshire.core :as json] '[clojure.string :as str] '[babashka.fs :as fs])
(let [dir (first *command-line-args*)
      _ (when-not dir (binding [*out* *err*] (println "usage: check-stage2.bb <evidence-dir>")) (System/exit 2))
      read-text (fn [p] (if (fs/exists? p) (slurp p) ""))
      lines (fn [p] (mapv #(json/parse-string % true) (remove str/blank? (str/split-lines (read-text p)))))
      homes (filter #(= "stored" (:kind %)) (lines (str dir "/logs/home.jsonl")))
      telegram (filter :ok (lines (str dir "/logs/telegram.jsonl")))
      journal (lines (str dir "/boxp-notify/journal.jsonl"))
      log (read-text (str dir ".log"))
      migration (str (read-text (str dir "/boxp-notify/journal.jsonl"))
                     (read-text (str (fs/parent dir) "/cron-migration-" (if (str/includes? (str (fs/file-name dir)) "cur") "cur" "new") ".txt")))
      validate (read-text (str dir ".validate.txt"))
      hc (fn [s] (count (filter #(str/includes? (str (get-in % [:payload :eventId])) s) homes)))
      tc (fn [s] (count (filter #(str/includes? (str (:text %)) s) telegram)))
      ec (fn [s] (count (filter #(= s (get-in % [:payload :eventType])) homes)))
      jk (fn [kind chat] (count (filter #(and (= kind (:kind %)) (= chat (:chat_id %))) journal)))
      matching (fn [kind id] (filter #(and (= kind (:kind %)) (str/includes? (str (:key %)) id)) journal))
      held (some #(and (str/includes? (str %) "tb-BOXP-9105-20261114T120005") (= "held" (:state (json/parse-string (slurp (str %)) true)))) (fs/glob (str dir "/boxp-notify/receipts") "*.json"))
      failed (atom false)
      check (fn [label condition] (println (str (if condition "ok " "FAIL ") label)) (when-not condition (reset! failed true)))]
  ;; BOXP-614: the held 9105 report is also stored at home during quiet hours (no Telegram), so 12.
  (check "home total 12" (= 12 (count homes)))
  (check "Telegram total 8 successful" (= 8 (count telegram)))
  (check "formal report and redelivery" (and (= 1 (hc "BOXP-9101")) (zero? (tc "BOXP-9101")) (pos? (jk "duplicate_dropped" "tb:BOXP-9101-20261114T120001Z-aaaa0001-done"))))
  (doseq [id ["9102" "9104"]] (check (str "notice " id) (and (= 1 (hc id)) (= 1 (tc id)))))
  (check "silent with receipt" (and (zero? (hc "9103")) (zero? (tc "9103"))))
  (check "quiet and digest" (and held (= 1 (hc "BOXP-9105-20261114T120005")) (= 1 (ec "task-board.morning-digest")) (zero? (tc "9105"))))
  (doseq [id ["9106" "9107"]] (check (str "fallback or route " id) (and (= 1 (hc id)) (= 1 (tc id)))))
  (check "home failure then recovery" (and (some #(and (false? (:home %)) (true? (:telegram %))) (matching "delivered_partial" "9106")) (seq (matching "recovered" "9106"))))
  (check "routing telegram" (some #(and (true? (:telegram %)) (false? (:primary %))) (matching "delivered" "9107")))
  (check "both down restart recovery" (and (= 1 (hc "9108")) (zero? (tc "9108")) (some #(= "recovery_failed" (:kind %)) journal) (some #(= "disconnect" (:kind %)) journal)))
  (check "old route 404" (str/includes? log "old-route http=404"))
  (check "cron success failure and dedup" (and (= 1 (ec "cron.report")) (= 1 (ec "cron.failure")) (= 1 (tc "lab の定期報告")) (= 1 (tc "lab-fail")) (pos? (jk "duplicate_dropped" "cron"))))
  (check "Alertmanager firing retry resolved" (and (= 1 (ec "alert.firing")) (= 1 (ec "alert.resolved")) (= 2 (tc "【Alertmanager 通知】")) (pos? (jk "duplicate_dropped" "direct:alertmanager"))))
  ;; K1: the agent's own cron tool call. Only a target meaning the home Telegram chat is rewritten; a job the
  ;; CLI creates without a target (origin) and local stay as written (same rule as the unit checks).
  (check "cron rewrite" (and (some #(and (= "cron_deliver_rewritten" (:kind %)) (str/includes? (str (:before %)) "telegram")
                                         (str/includes? (str (:after %)) "boxp_notify:cron")) journal)
                             (str/includes? log "job lab-tool-telegram deliver=boxp_notify:cron")
                             (str/includes? log "job lab-tool-origin deliver=origin")
                             (str/includes? log "job lab-tool-local deliver=local")))
  (check "cron migration deliver and failure_deliver" (and (str/includes? migration "cron_job_migrated") (str/includes? migration "\"deliver\": \"boxp_notify:cron\"") (str/includes? migration "\"failure_deliver\": \"boxp_notify:cron\"")))
  (check "image route" (every? #(str/includes? log %) ["no-key http=401" "wrong-key http=401" "image http=200" "traversal http=404" "fake-image http=404"]))
  (check "plugin validation" (and (str/includes? validate "Validation passed.") (not (str/includes? validate "Validation failed"))
                                  (every? #(str/includes? log (str "Validation passed.  <- " %)) ["boxp-notify" "kohako-g2-context" "kohako-g2-realtime" "kohako-vault-image" "boxp-ai-ops-observer" "boxp-langfuse-observer"])))
  (when @failed (System/exit 1)))
