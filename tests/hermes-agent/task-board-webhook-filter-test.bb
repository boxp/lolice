#!/usr/bin/env bb
(require '[clojure.string :as str] '[clojure.java.io :as io] '[cheshire.core :as json] '[babashka.process :as p])
(def tmp (.toFile (java.nio.file.Files/createTempDirectory "task-board-filter-test" (make-array java.nio.file.attribute.FileAttribute 0))))
(defn path [& xs] (str (apply io/file tmp xs)))
(def cm (slurp "argoproj/hermes-agent/configmap.yaml"))
(defn extract [key] (->> (str/split-lines cm) (drop-while #(not= % (str "  " key ": |"))) rest (take-while #(or (str/starts-with? % "    ") (str/blank? %))) (map #(if (str/starts-with? % "    ") (subs % 4) %)) (str/join "\n")))
(spit (path "filter.clj") (extract "task_board_webhook_filter.clj"))
(spit (path "filter.sh") (extract "task_board_webhook_filter.sh"))
(.mkdirs (io/file (path "vault" "Tickets")))
(spit (path "helper.bb") "(let [a *command-line-args* vault (nth a 3) note (nth a 7)] (spit (str vault \"/Tickets/\" (nth a 1) \".md\") (str note \"\\n\") :append true))")
(spit (path "runbook") (apply str (repeat 1100 "x")))
(spit (path "vault" "Tickets" "BOXP-491.md") "# Ticket\n")
(def env (merge (into {} (System/getenv)) {"TASK_BOARD_FILTER_RUNBOOK" (path "runbook") "TASK_BOARD_FILTER_VAULT" (path "vault") "TASK_BOARD_FILTER_HELPER" (path "helper.bb") "TASK_BOARD_FILTER_LOG" (path "log.jsonl")}))
(def payload {"event_type" "task-board.run-finished" "ticket_id" "BOXP-491" "event_id" "BOXP-491-test" "run_id" "run-1" "other" {"arbitrary" [1 2]}})
(defn run [raw & [e]] (:out (p/shell {:in raw :out :string :err :string :env (or e env)} "bb" (path "filter.clj"))))
(defn check [x msg] (when-not x (throw (ex-info msg {}))) (println "PASS" msg))
(def raw (json/generate-string payload))
(defn parsed [s] (json/parse-string s))
(defn hinted? [out data hint] (= (assoc (json/parse-string data) "supervision" hint) (parsed out)))
(def ticket-before (slurp (path "vault" "Tickets" "BOXP-491.md")))
(doseq [registered ["BOXP-491" " 491 "]]
  (spit (path "runbook") (str (apply str (repeat 1100 "x")) registered))
  (check (hinted? (run raw) raw "check-runbook") (str "registered " registered " passes with check-runbook")))
;; BOXP-667: an unregistered ticket is no longer silenced. It passes as report-only and
;; the filter writes nothing to the ticket (the handled marker belongs to the agent run).
(doseq [near ["BOXP-4910" " 1491 " "BOXP-49"]]
  (spit (path "runbook") (str (apply str (repeat 1100 "x")) near))
  (check (hinted? (run raw) raw "unregistered") (str "near miss " near " is unregistered")))
(spit (path "runbook") (apply str (repeat 1100 "x")))
(def unregistered-out (run raw))
(check (not= "[SILENT]" unregistered-out) "unregistered ticket is not silenced")
(check (hinted? unregistered-out raw "unregistered") "unregistered passes as report-only with the full payload")
(check (= ticket-before (slurp (path "vault" "Tickets" "BOXP-491.md"))) "filter writes no marker for an unregistered ticket")
(check (hinted? (run (json/generate-string (assoc payload "supervision" "check-runbook"))) raw "unregistered") "a payload-supplied supervision value is overwritten")
(doseq [status ["done" "blocked"]]
  (let [data (json/generate-string (assoc payload "event_type" "task-board.lane-changed" "to_status" status "event_id" (str "BOXP-491-lane-" status) "run_id" nil))]
    (check (hinted? (run data) data "unregistered") (str "unregistered lane change to " status " passes"))))
;; Duplicate delivery of an unregistered ticket is dropped here. A possibly registered ticket or an
;; unreadable runbook keeps passing: the agent turn and the channel dedupe handle those (notify lab).
(spit (path "vault" "Tickets" "BOXP-491.md") "- [kohako-event] handled event=BOXP-491-test run=run-1 result=notified summary=done\n" :append true)
(def content (slurp (path "vault" "Tickets" "BOXP-491.md")))
(check (= "[SILENT]" (run raw)) "already handled (unregistered)")
(spit (path "runbook") (str (apply str (repeat 1100 "x")) "BOXP-491"))
(check (hinted? (run raw) raw "check-runbook") "already handled but possibly registered still passes")
(spit (path "runbook") "short")
(check (hinted? (run raw) raw "unknown") "already handled with unreadable runbook still passes")
(spit (path "runbook") (apply str (repeat 1100 "x")))
(check (= content (slurp (path "vault" "Tickets" "BOXP-491.md"))) "no append on duplicate")
(def fresh (json/generate-string (assoc payload "event_id" "BOXP-491-fresh")))
(check (hinted? (run fresh) fresh "unregistered") "marker of another event does not silence")
(check (hinted? (run fresh (assoc env "TASK_BOARD_FILTER_HELPER" (path "missing"))) fresh "unregistered") "filter does not depend on the helper")
(spit (path "vault" "Tickets" "BOXP-491.md") "legacy handled event=BOXP-491-legacy summary=old\n" :append true)
(check (= "[SILENT]" (run (json/generate-string (assoc payload "event_id" "BOXP-491-legacy")))) "legacy marker")
(spit (path "vault" "Tickets" "BOXP-491.md") "note summary=handled event=BOXP-491-quoted\n" :append true)
(check (hinted? (run (json/generate-string (assoc payload "event_id" "BOXP-491-quoted"))) (json/generate-string (assoc payload "event_id" "BOXP-491-quoted")) "unregistered") "marker text inside a summary is not a marker")
(doseq [[label data] [["malformed" "{bad"] ["unknown" (json/generate-string (assoc payload "event_type" "other"))] ["digest" (json/generate-string (assoc payload "event_type" "task-board.morning-digest"))] ["bad ticket" (json/generate-string (assoc payload "ticket_id" "../x"))] ["bad event" (json/generate-string (assoc payload "event_id" "BOXP-491-evil newline\n"))]]]
  (check (= data (run data)) label))
(spit (path "runbook") "short")
(check (hinted? (run fresh) fresh "unknown") "short runbook passes as unknown")
(check (hinted? (run fresh (assoc env "TASK_BOARD_FILTER_RUNBOOK" (path "absent"))) fresh "unknown") "missing runbook passes as unknown")
(spit (path "runbook") (apply str (repeat 1100 "x")))
(check (hinted? (run fresh (assoc env "TASK_BOARD_FILTER_VAULT" (path "missing"))) fresh "unregistered") "missing ticket file still passes")
(.mkdirs (io/file (path "bin")))
(spit (path "bin" "bb") "#!/bin/sh\nexit 1\n")
(.setExecutable (io/file (path "bin" "bb")) true)
(check (= raw (:out (p/shell {:in raw :out :string :env (assoc env "PATH" (str (path "bin") ":" (System/getenv "PATH")))} "sh" (path "filter.sh")))) "wrapper fallback")
(def logs (map json/parse-string (str/split-lines (slurp (path "log.jsonl")))))
(check (every? #(contains? #{"pass" "silent-already-handled"} (get % "decision")) logs) "decision logs")
(check (some #(= "unregistered-report-only" (get % "reason")) logs) "report-only reason logged")
;; Route prompt contract (BOXP-667): delivery for every ticket, continuation only when registered.
(def route (json/parse-string (extract "task_board_webhook_route.json")))
(def prompt (get-in route ["task-board-channel" "prompt"]))
(check (not (str/includes? prompt "登録が無い ticket は通知も調整もしない")) "prompt no longer silences unregistered tickets")
(check (str/includes? prompt "supervision={supervision}") "prompt receives the supervision hint")
(check (str/includes? prompt "未登録であることだけを理由に result=silent にしません") "prompt forbids silence for registration alone")
(check (str/includes? prompt "検収・継続操作・状態変更・再 queue・helper の限定実行は一切せず") "prompt keeps report-only without intervention")
(check (str/includes? prompt "（report-only の票は対象外）") "continuation excludes report-only tickets")
(println "All Task Board filter tests passed")
