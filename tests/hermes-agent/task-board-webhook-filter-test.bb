#!/usr/bin/env bb
(require '[clojure.string :as str] '[clojure.java.io :as io] '[cheshire.core :as json] '[babashka.process :as p])
(def tmp (.toFile (java.nio.file.Files/createTempDirectory "task-board-filter-test" (make-array java.nio.file.attribute.FileAttribute 0))))
(defn path [& xs] (str (apply io/file tmp xs)))
(def cm (slurp "argoproj/hermes-agent/configmap.yaml"))
(defn extract [key] (->> (str/split-lines cm) (drop-while #(not= % (str "  " key ": |"))) rest (take-while #(or (str/starts-with? % "    ") (str/blank? %))) (map #(if (str/starts-with? % "    ") (subs % 4) %)) (str/join "\n")))
(spit (path "filter.clj") (extract "task_board_webhook_filter.clj"))
(spit (path "filter.sh") (extract "task_board_webhook_filter.sh"))
(.mkdirs (io/file (path "vault" "Tickets")))
(spit (path "helper.bb") "(let [a *command-line-args* vault (nth a 3) note (nth a 7)] (spit (str vault \"/Tickets/\" (nth a 1) \".md\") (str note \"\\n\") :append true))")
(spit (path "runbook") (apply str (repeat 1100 "x")))
(spit (path "vault" "Tickets" "BOXP-491.md") "# Ticket\n")
(def env (merge (into {} (System/getenv)) {"TASK_BOARD_FILTER_RUNBOOK" (path "runbook") "TASK_BOARD_FILTER_VAULT" (path "vault") "TASK_BOARD_FILTER_HELPER" (path "helper.bb") "TASK_BOARD_FILTER_LOG" (path "log.jsonl")}))
(def payload {"event_type" "task-board.run-finished" "ticket_id" "BOXP-491" "event_id" "BOXP-491-test" "run_id" "run-1" "other" {"arbitrary" [1 2]}})
(defn run [raw & [e]] (:out (p/shell {:in raw :out :string :err :string :env (or e env)} "bb" (path "filter.clj"))))
(defn check [x msg] (when-not x (throw (ex-info msg {}))) (println "PASS" msg))
(def raw (json/generate-string payload))
(doseq [registered ["BOXP-491" " 491 "]]
  (spit (path "runbook") (str (apply str (repeat 1100 "x")) registered))
  (check (= raw (run raw)) (str "registered " registered)))
(spit (path "runbook") (apply str (repeat 1100 "x")))
(check (= "[SILENT]" (run raw)) "unregistered appended")
(def content (slurp (path "vault" "Tickets" "BOXP-491.md")))
(check (str/includes? content "event=BOXP-491-test run=run-1 result=silent") "marker exists")
(check (= "[SILENT]" (run raw)) "already handled")
(check (= content (slurp (path "vault" "Tickets" "BOXP-491.md"))) "no duplicate append")
(def fresh (json/generate-string (assoc payload "event_id" "BOXP-491-fresh")))
(check (= fresh (run fresh (assoc env "TASK_BOARD_FILTER_HELPER" (path "missing")))) "helper failure")
(spit (path "noop.bb") "(System/exit 0)")
(check (= fresh (run fresh (assoc env "TASK_BOARD_FILTER_HELPER" (path "noop.bb")))) "helper success without marker")
(spit (path "vault" "Tickets" "BOXP-491.md") "legacy handled event=BOXP-491-legacy summary=old\n" :append true)
(check (= "[SILENT]" (run (json/generate-string (assoc payload "event_id" "BOXP-491-legacy")))) "legacy marker")
(doseq [[label data] [["malformed" "{bad"] ["unknown" (json/generate-string (assoc payload "event_type" "other"))] ["digest" (json/generate-string (assoc payload "event_type" "task-board.morning-digest"))] ["bad ticket" (json/generate-string (assoc payload "ticket_id" "../x"))] ["bad event" (json/generate-string (assoc payload "event_id" "BOXP-491-evil newline\n"))]]]
  (check (= data (run data)) label))
(spit (path "runbook") "short")
(check (= fresh (run fresh)) "short runbook")
(check (= fresh (run fresh (assoc env "TASK_BOARD_FILTER_RUNBOOK" (path "absent")))) "missing runbook")
(spit (path "runbook") (apply str (repeat 1100 "x")))
(check (= fresh (run fresh (assoc env "TASK_BOARD_FILTER_VAULT" (path "missing")))) "missing ticket")
(.mkdirs (io/file (path "bin")))
(spit (path "bin" "bb") "#!/bin/sh\nexit 1\n")
(.setExecutable (io/file (path "bin" "bb")) true)
(check (= raw (:out (p/shell {:in raw :out :string :env (assoc env "PATH" (str (path "bin") ":" (System/getenv "PATH")))} "sh" (path "filter.sh")))) "wrapper fallback")
(check (every? #(contains? #{"pass" "silent-unregistered" "silent-already-handled"} (get (json/parse-string %) "decision")) (str/split-lines (slurp (path "log.jsonl")))) "decision logs")
(println "All Task Board filter tests passed")
