      },
      "refresh" : 2,
      "name" : "namespace",
      "type" : "query",
      "allValue" : ".*",
      "multi" : true,
      "label" : "namespace",
      "current" : {
        "selected" : true,
        "text" : [ "All" ],
        "value" : [ "$__all" ]
      },
      "query" : {
        "query" : "label_values(kube_namespace_status_phase, namespace)",
        "refId" : "var-namespace",
        "qryType" : 1
      },
      "sort" : 1,
      "includeAll" : true
    }, {
      "name" : "severity",
      "type" : "custom",
      "allValue" : ".*",
      "multi" : true,
      "label" : "severity",
      "current" : {
        "selected" : true,
        "text" : [ "All" ],
