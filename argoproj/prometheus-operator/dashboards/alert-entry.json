      "cellHeight" : "sm"
    }
  }, {
    "description" : "最上段の「判定経路（Watchdog）」は Prometheus がルールを評価し、その結果が保存されていた時間に緑で出ます。緑が途切れた時間（Prometheus 停止など）は全行が欠測です。緑でも、別のルールグループの評価失敗（紫「評価失敗 <rule_group>」）や監視対象の取得失敗（橙「取得失敗 <job>」）は起こり、そのルール・対象に関するアラートはその時間だけ判定されていません。空白を「鳴っていない（正常）」と読めるのは、判定経路が緑で、かつ関係するルールグループ・job の紫/橙の帯が出ていない時間だけです。対象が丸ごと消えた場合は帯も出ないため、下の「監視対象の消失・減少」で確かめます。",
    "datasource" : {
      "type" : "prometheus",
      "uid" : "${datasource}"
    },
    "gridPos" : {
      "x" : 0,
      "y" : 21,
      "w" : 24,
      "h" : 9
    },
    "type" : "state-timeline",
    "targets" : [ {
      "refId" : "A",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "max(3 * ALERTS{alertname=\"Watchdog\", alertstate=\"firing\"})",
      "legendFormat" : "判定経路（Watchdog）"
    }, {
      "refId" : "B",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "max by (alertname, severity) (2 * ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"}) or max by (alertname, severity) (ALERTS{alertstate=\"pending\", alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"})",
      "legendFormat" : "{{alertname}} ({{severity}})"
    }, {
      "refId" : "C",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "max by (rule_group) (0 * (increase(prometheus_rule_evaluation_failures_total[5m]) > 0) + 4)",
      "legendFormat" : "評価失敗 {{rule_group}}"
    }, {
      "refId" : "D",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "max by (job) (0 * (up == 0) + 5)",
      "legendFormat" : "取得失敗 {{job}}"
    } ],
    "title" : "いつ鳴っていたか（Pending / Firing の時間帯と、その間の監視の穴）",
    "fieldConfig" : {
      "defaults" : {
        "color" : {
          "mode" : "thresholds"
        },
        "custom" : {
          "insertNulls" : 120000,
          "spanNulls" : false
        },
        "thresholds" : {
          "mode" : "absolute",
          "steps" : [ {
            "color" : "yellow",
            "value" : null
          }, {
            "color" : "red",
            "value" : 2
          }, {
            "color" : "green",
            "value" : 3
          }, {
            "color" : "purple",
            "value" : 4
          }, {
            "color" : "orange",
            "value" : 5
          } ]
        },
        "mappings" : [ {
          "type" : "value",
          "options" : {
            "1" : {
              "text" : "Pending",
              "color" : "yellow"
