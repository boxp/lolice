  "tags" : [ "monitoring", "alerting", "entry" ],
  "timezone" : "Asia/Tokyo",
  "refresh" : "1m",
  "editable" : false,
  "graphTooltip" : 1,
  "uid" : "alert-entry",
  "time" : {
    "from" : "now-24h",
    "to" : "now"
