    "options" : {
      "reduceOptions" : {
        "calcs" : [ "lastNotNull" ],
        "fields" : "",
        "values" : false
      },
      "colorMode" : "background",
      "graphMode" : "none",
      "textMode" : "value_and_name",
      "justifyMode" : "center"
    }
  }, {
    "description" : "Prometheus の判定結果（ALERTS）。抑制（silence / inhibit）されていても判定は Firing のまま表示されます。通知が止まっているかは上の「抑制中」と Alertmanager で確認します。",
    "datasource" : {
      "type" : "prometheus",
      "uid" : "${datasource}"
    },
    "gridPos" : {
      "x" : 0,
      "y" : 11,
      "w" : 24,
      "h" : 10
    },
    "transformations" : [ {
      "id" : "merge",
      "options" : { }
    }, {
      "id" : "organize",
      "options" : {
        "excludeByName" : {
          "Time" : true,
          "__name__" : true
        },
        "renameByName" : {
          "Value #A" : "active_at",
          "Value #B" : "investigate_from"
        },
        "indexByName" : {
          "alertstate" : 0,
          "severity" : 1,
          "alertname" : 2,
          "namespace" : 3,
          "active_at" : 4
        }
      }
    } ],
    "type" : "table",
    "targets" : [ {
      "refId" : "A",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "1000 * (ALERTS_FOR_STATE{alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"} * ignoring(alertstate) group_left(alertstate) ALERTS{alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"})",
      "instant" : true,
      "range" : false,
      "format" : "table"
    }, {
      "refId" : "B",
      "datasource" : {
        "type" : "prometheus",
        "uid" : "${datasource}"
      },
      "expr" : "1000 * ((ALERTS_FOR_STATE{alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"} * ignoring(alertstate) group_left(alertstate) ALERTS{alertname!~\"Watchdog|InfoInhibitor\", alertname=~\"${alertname}\", namespace=~\"${namespace}\", severity=~\"${severity}\"}) - 1800)",
      "instant" : true,
      "range" : false,
      "format" : "table"
    } ],
    "title" : "Firing / Pending のアラート（抑制中も含む。行のリンクで掘り下げ）",
