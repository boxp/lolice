        {
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"baseline_missing\"} == 1) * 2",
          "refId": "B",
          "legendFormat": "baseline_missing",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
