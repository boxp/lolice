        {
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"baseline_invalid\"} == 1) * 3",
          "refId": "C",
          "legendFormat": "baseline_invalid",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
        },
        {
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"usage_ledger_invalid\"} == 1) * 4",
          "refId": "D",
          "legendFormat": "usage_ledger_invalid",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
        },
        {
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"currency_mismatch\"} == 1) * 5",
          "refId": "E",
          "legendFormat": "currency_mismatch",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"usage_ledger_missing\"} == 1) * 6",
          "refId": "F",
          "instant": true,
          "range": false,
          "legendFormat": "usage_ledger_missing"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(ai_prepaid_estimate_state{job=\"codex-workspace-ai-ops-metrics\",state=\"usage_coverage_unconfirmed\"} == 1) * 7",
          "refId": "G",
          "instant": true,
          "range": false,
          "legendFormat": "usage_coverage_unconfirmed"
