                  "text": "基準未設定"
                },
                "3": {
                  "text": "基準不正"
                },
                "4": {
                  "text": "ledger不正行あり"
                },
                "5": {
                  "text": "通貨不一致"
                },
                "6": {
                  "text": "ledger未作成/読取不可"
                },
                "7": {
                  "text": "利用記録の網羅未確認"
                }
