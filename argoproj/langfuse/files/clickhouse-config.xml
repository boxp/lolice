<!-- BOXP-428: low-memory single node. System log tables are removed because their rows
     can hold query text, and those tables are outside the Langfuse deletion API. -->
<clickhouse>
    <logger><level>warning</level></logger>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <part_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <session_log remove="1"/>
    <crash_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <zookeeper_log remove="1"/>
    <s3queue_log remove="1"/>
</clickhouse>
