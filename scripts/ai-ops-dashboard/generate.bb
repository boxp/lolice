#!/usr/bin/env bb
(require '[cheshire.core :as json] '[clojure.string :as str] '[babashka.process :as proc])
(def path "argoproj/prometheus-operator/dashboards/ai-ops-quality.json")
(def doc-path "docs/project_docs/BOXP-472/panel-map.md")
(def dashboard (json/parse-string (slurp path) true))
(def fixed #{221 216 101 219 49})
(def state #{3 4 214 232 233 234 11 12 21 22 30 31 103 105 106 107 109 110})
(def gauge #{231 201 202 204 205 206 207 208 209 210 211 212 16 17 51 213 215 9 5 42 43 44 27 18 26 218 10 48 6 50 102 104 108 46 220 40 41 14 15 45})
(def bins #{8 23 7})
(def existing #{19 28 29})
(def classification (merge (zipmap fixed (repeat :fixed)) (zipmap state (repeat :state)) (zipmap gauge (repeat :gauge)) (zipmap bins (repeat :bin)) (zipmap existing (repeat :existing))))
(defn clean-panel [p] (update p :panels #(when % (vec (filter (fn [x] (< (:id x) 1000)) %)))))
(def originals (->> (:panels dashboard) (filter #(< (:id %) 1000)) (mapv #(if (:panels %) (clean-panel %) %))))
(def all-original (mapcat #(if (= "row" (:type %)) (:panels %) [%]) originals))
(doseq [p all-original] (when-not (classification (:id p)) (throw (ex-info "未分類の panel" {:id (:id p)}))))
(def counter (atom 999))
(defn next-id [] (swap! counter inc))
(def prom {:type "prometheus" :uid "${datasource}"})
(def ch {:type "grafana-clickhouse-datasource" :uid "langfuse-clickhouse"})
(def desc "収集 60s・保持 31d・Pod 更新で系列が切れる場合がある。欠測は 0 ではありません。")
(defn pos [i] {:x (* 12 (mod i 2)) :y (* 8 (quot i 2)) :w 12 :h 8})
(def a-size [[24 7] [24 8] [24 6] [24 8] [24 9] [24 7] [24 5] [24 10] [8 8] [8 8] [8 8] [12 10] [12 10]])
(defn pack [sizes] (loop [ss sizes x 0 y 0 h 0 out []] (if-let [[w hh] (first ss)] (let [wrap? (> (+ x w) 24) x (if wrap? 0 x) y (if wrap? (+ y h) y) h (if wrap? 0 h)] (recur (rest ss) (+ x w) y (max h hh) (conj out {:x x :y y :w w :h hh}))) out)))
(defn pt [expr legend] {:refId "A" :datasource prom :expr expr :legendFormat legend :instant false :range true})
(defn series [title expr legend unit] {:id (next-id) :title title :type "timeseries" :datasource prom :description desc :targets [(pt expr legend)] :fieldConfig {:defaults {:unit unit :noValue "未計測" :custom {:spanNulls false :drawStyle "line"}} :overrides []} :options {:legend {:displayMode "list" :placement "bottom" :calcs []}}})
(def job "{job=\"codex-workspace-ai-ops-metrics\"}")
(def U (str "max by (provider,name,limit,window) (ai_subscription_window_used_percent" job ")"))
(def R (str "max by (provider,name,limit,window) (ai_subscription_window_resets_at_seconds" job ")"))
;; offset must be attached to the selector, not the aggregation.
(def U1 (str "max by (provider,name,limit,window) (ai_subscription_window_used_percent" job " offset 1m)"))
(def R1 (str "max by (provider,name,limit,window) (ai_subscription_window_resets_at_seconds" job " offset 1m)"))
(def delta (str "sum_over_time(((" U " - " U1 ") unless on(provider,name,limit,window) (abs(" R " - " R1 ") > 3600))[$__interval:1m])"))
(def where "WHERE $__timeFilter(start_time) AND model IN (${model:singlequote}) AND route IN (${route:singlequote}) AND provider IN (${provider:singlequote})")
(def new-tokens "input_tokens+cache_write_tokens+output_tokens+reasoning_tokens")
(def metrics (str "count() AS generations, sum(input_tokens) AS input_tokens, sum(cache_write_tokens) AS cache_write_tokens, sum(cache_read_tokens) AS cache_read_tokens, sum(output_tokens) AS output_tokens, sum(reasoning_tokens) AS reasoning_tokens, sum(" new-tokens ") AS 新規合計, sum(total_tokens) AS total_tokens"))
(defn sqlpanel [title type sql] {:id (next-id) :title title :type type :datasource ch :description "選択期間の GENERATION のみ。Langfuse 保持は 14 日、欠測は 0 ではありません。" :targets [{:refId "A" :datasource ch :editorType "sql" :queryType (if (= type "timeseries") "timeseries" "table") :format (if (= type "timeseries") 0 1) :rawSql sql :pluginVersion "4.23.4"}] :fieldConfig {:defaults {:noValue "未計測" :custom {:spanNulls false}} :overrides []} :options (if (= type "timeseries") {:legend {:displayMode "list" :placement "bottom" :calcs ["sum"]}} {:showHeader true})})
;; bin を使う panel は時系列も表も同じ幅にする。未指定だと表は panel 幅から別の bin 幅になる。
(defn binned [p] (assoc p :interval "$bin" :maxDataPoints 2016))
(defn bar [p stack] (-> p binned (assoc-in [:fieldConfig :defaults :custom] {:spanNulls false :drawStyle "bars" :stacking {:mode stack :group "A"}})))
(def intro {:id (next-id) :title "見方と限界" :type "text" :options {:mode "markdown" :content "**読み方**: 上の利用枠と token の時系列でピークを drag で選ぶと、下の内訳の表も同じ期間に変わります。JST 固定。時刻範囲はダッシュボード共通です。Prometheus は 60 秒 scrape・保持 31 日、Langfuse は保持 14 日です。14 日より前は token 系列なしであり 0 ではありません。Task Board は run 終了後に export するため実行中は後から埋まります。token を quota% や金額へ比例配賦しません。契約内 token は API 料金ではありません。bin は $__interval（最小 $bin）で、重ならない bin は 1h 移動窓の線と異なります。導入前の欠測は 0 ではなく、未分類は経路を特定できない観測です。選択期間の集計は固定 7d/28d 窓と異なります。"}})
(def panels-a (let [base [(assoc intro :gridPos (pos 0))
 (series "利用枠 used%（Prometheus）" (str "max by (provider,name,limit,window) (ai_subscription_window_used_percent" job " unless on(provider,limit,name,window,pod) (ai_subscription_window_resets_at_seconds" job " <= time()))") "{{provider}} {{name}} ({{window}})" "percent")
 (series "利用枠 観測からの経過時間" (str "time() - max by(provider,name,limit,window) (ai_subscription_window_observed_timestamp_seconds" job ")") "{{provider}} {{name}} ({{window}})" "s")
 (bar (series "利用枠 bin ごとの増加 pt" delta "{{provider}} {{name}} ({{window}})" "short") "none")]
 t1 (bar (sqlpanel "新規 token / bin（経路別）" "timeseries" (str "SELECT toStartOfInterval(start_time, toIntervalSecond($__interval_s)) AS time, route, sum(" new-tokens ") AS value FROM ai_ops_usage_v1 " where " GROUP BY time, route ORDER BY time")) "normal")
 t2 (bar (sqlpanel "cache read token / bin（経路別）" "timeseries" (str "SELECT toStartOfInterval(start_time, toIntervalSecond($__interval_s)) AS time, route, sum(cache_read_tokens) AS value FROM ai_ops_usage_v1 " where " GROUP BY time, route ORDER BY time")) "normal")
 stat (sqlpanel "集計一致" "table" (str "WITH filtered AS (SELECT * FROM ai_ops_usage_v1 " where "), totals AS (SELECT sum(total_tokens) AS total, count() AS generations, countIf(has_usage=0) AS usage未取得, sum(other_tokens) AS other_tokens, countIf(route='(未分類)') AS 未分類 FROM filtered), routes AS (SELECT sum(total_tokens) AS n FROM filtered GROUP BY route), models AS (SELECT sum(total_tokens) AS n FROM filtered GROUP BY model), bins AS (SELECT sum(total_tokens) AS n FROM filtered GROUP BY toStartOfInterval(start_time, toIntervalSecond($__interval_s))) SELECT total - (SELECT sum(n) FROM routes) AS 経路差分, total - (SELECT sum(n) FROM models) AS モデル差分, total - (SELECT sum(n) FROM bins) AS bin差分, generations, usage未取得, other_tokens, 未分類 FROM totals"))
 tb (sqlpanel "時間 bin 別" "table" (str "SELECT toStartOfInterval(start_time, toIntervalSecond($__interval_s)) AS bin, toUnixTimestamp(bin)*1000 AS bin_start_ms, (toUnixTimestamp(bin)+$__interval_s)*1000 AS bin_end_ms, " metrics ", sumIf(" new-tokens ", provider='claude') AS claude, sumIf(" new-tokens ", provider='codex') AS codex FROM ai_ops_usage_v1 " where " GROUP BY bin ORDER BY 新規合計 DESC"))
 groups (mapv (fn [col title] (sqlpanel title "table" (str "SELECT " col ", " metrics ", sum(" new-tokens ") / nullIf(sum(sum(" new-tokens ")) OVER (),0)*100 AS share_percent FROM ai_ops_usage_v1 " where " GROUP BY " col " ORDER BY 新規合計 DESC"))) ["provider" "model" "route"] ["provider 別" "model 別" "経路別"])
 ticket (sqlpanel "ticket 上位（Task Board）" "table" (str "SELECT ticket, " metrics ", min(start_time) AS first_JST, max(start_time) AS last_JST, groupUniqArray(route) AS routes FROM ai_ops_usage_v1 " where " AND ticket != '' GROUP BY ticket ORDER BY 新規合計 DESC LIMIT 50"))
 trace (sqlpanel "trace 上位" "table" (str "SELECT route, ticket, trace_id, substring(trace_id,1,8) AS trace_short, " metrics " FROM ai_ops_usage_v1 " where " GROUP BY route, ticket, trace_id ORDER BY 新規合計 DESC LIMIT 50"))]
 (mapv (fn [g p] (assoc p :gridPos g)) (pack a-size) (concat base [t1 t2 (binned stat) (binned (assoc-in tb [:fieldConfig :overrides] [{:matcher {:id "byName" :options "bin"} :properties [{:id "links" :value [{:title "この bin に絞る" :url "/d/ai-ops-quality/?from=${__data.fields.bin_start_ms}&to=${__data.fields.bin_end_ms}&${__all_variables}"}]}]}]))] groups [(assoc-in ticket [:fieldConfig :overrides] [{:matcher {:id "byName" :options "ticket"} :properties [{:id "links" :value [{:title "Langfuse セッション" :url "https://langfuse.b0xp.io/project/ai-ops/sessions/${__value.raw}"}]}]}]) (assoc-in trace [:fieldConfig :overrides] [{:matcher {:id "byName" :options "trace_short"} :properties [{:id "links" :value [{:title "Langfuse trace" :url "https://langfuse.b0xp.io/project/ai-ops/traces/${__data.fields.trace_id}"}]}]}])]))))
(def state-text {3 {0 "停止" 1 "稼働"} 4 {0 "停止" 1 "稼働"} 214 {0 "失敗" 1 "成功"} 232 {0 "なし" 1 "あり"} 233 {0 "非該当" 1 "該当"} 234 {1 "発火中"} 11 {0 "未接続" 1 "接続" 2 "一部接続"} 21 {0 "未接続" 1 "接続" 2 "一部接続"} 22 {0 "未接続" 1 "接続" 2 "一部接続"} 30 {0 "未接続" 1 "接続" 2 "一部接続"} 31 {0 "未接続" 1 "接続" 2 "一部接続"} 12 {0 "判定不能" 1 "判定可"} 103 {1 "該当"} 105 {1 "該当"} 106 {0 "なし" 1 "あり"} 107 {1 "該当"} 109 {0 "未提供" 1 "提供中"} 110 {1 "制限中"}})
;; 1 が悪い状態を示す panel。残りは 1 が正常。
(def one-is-bad #{232 233 234 107 110})
(defn state-defaults [id] {:noValue "未計測" :mappings [{:type "value" :options (into {} (for [[v text] (state-text id)] [(str v) {:text text :index v}]))}] :color {:mode "thresholds"} :thresholds {:mode "absolute" :steps (if (one-is-bad id) [{:color "green" :value nil} {:color "red" :value 1}] [{:color "red" :value nil} {:color "green" :value 1}])} :custom {:spanNulls false :fillOpacity 70 :lineWidth 0}})
(def state-options {:mergeValues true :showValue "auto" :alignValue "left" :rowHeight 0.8 :legend {:displayMode "list" :placement "bottom"} :tooltip {:mode "single"}})
(def map-lines (atom []))
(defn source-target [t] (-> t (assoc :instant false :range true) (dissoc :format)))
(defn generated [p row old?]
 (let [id (:id p) kind (classification id) source (:targets p) source (cond->> source (#{103 109 110} id) (filter #(= "A" (:refId %))) (= id 233) (remove #(= "B" (:refId %))) (= id 106) (filter #(#{"A" "C"} (:refId %))) (= id 104) (filter #(not (str/includes? (:expr %) "1000"))) (= id 106) (remove #(= "D" (:refId %))) (= id 215) (remove #(= "Q4" (:refId %))))
       title (str (when old? "旧Review・比較不可: ") (:title p) (when (#{212 26 46} id) "（累積 snapshot の推移。選択時間帯内の分位ではない）") (when (= kind :bin) "（bin ごとの増分）"))
       panel (when-not (#{:fixed :existing} kind)
        (let [targets (mapv (fn [t] (let [e (:expr t) e (cond (= id 234) "max by(alertname)(ALERTS{component=\"ai-ops\",alertstate=\"firing\"})" (= kind :bin) (str/replace e "$__range" "$__interval") (#{11 12 21 22 30 31} id) (str "max by (sli) (" e ")") (#{:gauge :state} kind) (str "max without (pod,instance,container,endpoint,service,namespace" (when-not (= id 5) ",job") ") (" e ")") :else e)] (assoc (source-target t) :expr e))) source)
              typ (if (= kind :state) "state-timeline" "timeseries")]
          (cond-> {:id (next-id) :title title :type typ :datasource prom :description (str desc " " (:description p) (when (#{212 26 46} id) " 全履歴を再計算した snapshot の推移。")) :targets targets :fieldConfig {:defaults (if (= kind :state) (state-defaults id) (merge (get-in p [:fieldConfig :defaults]) {:noValue "未計測" :custom {:spanNulls false :drawStyle (if (= kind :bin) "bars" "line")}})) :overrides []} :options (if (= kind :state) state-options {:legend {:displayMode "list" :placement "bottom" :calcs []}})} (= kind :bin) (assoc :interval "$bin"))))]
  (swap! map-lines conj (str "| " id " | " (str/replace (:title p) "|" "\\|") " | " row " | " (case kind :fixed "固定情報" :state "状態履歴" "時系列") " | " (if panel (str (:id panel) " " title (when (= id 215) " / 数字の信頼性（完全性の状態）")) "—") " | " (case kind :fixed "説明または情報ラベルのため系列化しない" :existing "既存の時系列を利用" :state "観測状態を履歴表示" :bin "選択期間の増分を bin に変更" "観測値の推移") (when (= id 106) "。D plan_info は固定情報") " |"))
  (cond-> (if panel [panel] []) (= id 215) (conj {:id (next-id) :title "数字の信頼性（完全性の状態）" :type "state-timeline" :datasource prom :description desc :targets [(update (source-target (last (:targets p))) :expr #(str "max without (pod,instance,container,endpoint,service,namespace,job) (" % ")"))] :fieldConfig {:defaults {:noValue "未計測" :mappings [{:type "value" :options {"0" {:text "不完全"} "1" {:text "完全"}}}] :custom {:spanNulls false}} :overrides []}}))))
(def sections (atom []))
(loop [ps originals section nil members [] out []]
 (if-let [p (first ps)]
  (if (= "row" (:type p))
   (do (when section (swap! sections conj [section members])) (recur (rest ps) p (vec (:panels p)) out))
   (recur (rest ps) section (if section (conj members p) members) out))
  (when section (swap! sections conj [section members]))))
;; panel 221 precedes the first section.
(generated (first originals) "案内" false)
(def generated-rows (into {} (for [[row members] @sections :let [name (:title row) old? (= 227 (:id row)) children (vec (mapcat #(generated % name old?) members))]] [(:id row) {:id (next-id) :type "row" :title (str "時系列: " name (when old? "（現行と比較不可）")) :collapsed true :gridPos {:x 0 :y 999 :w 24 :h 1} :panels (mapv #(assoc %1 :gridPos (pos %2)) children (range))}])))
(def row-a {:id (next-id) :type "row" :title "消費タイムライン → 同じ期間の内訳（JST。drag で範囲選択すると下の内訳も連動）" :collapsed false :gridPos {:x 0 :y 999 :w 24 :h 1}})
(defn insert-rows [ps] (loop [ps ps out [] active nil] (if-let [p (first ps)] (if (= "row" (:type p)) (recur (rest ps) (cond-> out active (conj (generated-rows active)) (= 225 (:id p)) (into (cons row-a panels-a)) true (conj p)) (:id p)) (recur (rest ps) (conj out p) active)) (cond-> out active (conj (generated-rows active))))))
(def vars (concat [{:name "bin" :label "最小 bin" :type "custom" :query "5m,15m,1h" :current {:text "1h" :value "1h"}}] (for [n ["provider" "model" "route"]] {:name n :label n :type "query" :datasource ch :query (str "SELECT DISTINCT " n " FROM ai_ops_usage_v1 WHERE start_time >= now() - INTERVAL 14 DAY ORDER BY " n) :refresh 2 :includeAll true :multi true :current {:text "All" :value ["$__all"]}})))
(def annotation {:name "利用枠 reset" :enable true :datasource prom :expr (str "abs(" R " - max by (provider,name,limit,window) (ai_subscription_window_resets_at_seconds" job " offset 5m)) > 3600") :step "300" :titleFormat "{{provider}} {{name}} reset" :iconColor "rgba(255, 96, 96, 1)"})
(defn layout [ps]
 (loop [ps ps out [] y 0]
  (if-let [p (first ps)]
   (if (= "row" (:type p))
    (let [block (vec (take-while #(not= "row" (:type %)) (rest ps)))
          base (if (seq block) (apply min (map #(get-in % [:gridPos :y]) block)) 0)
          placed (mapv #(update-in % [:gridPos :y] + (- (+ y 1) base)) block)
          bottom (reduce max (+ y 1) (map #(+ (get-in % [:gridPos :y]) (get-in % [:gridPos :h])) placed))]
     (recur (drop (inc (count block)) ps) (into (conj out (assoc-in p [:gridPos :y] y)) placed) bottom))
    (recur (rest ps) (conj out (assoc-in p [:gridPos :y] y)) (+ y (get-in p [:gridPos :h]))))
   out)))
(def result (-> dashboard (assoc :panels (layout (insert-rows originals)) :timezone "Asia/Tokyo" :version 3) (assoc-in [:templating :list] (vec (concat (filter #(not (#{"bin" "provider" "model" "route"} (:name %))) (get-in dashboard [:templating :list])) vars))) (update-in [:annotations :list] #(conj (vec (remove (fn [a] (= "利用枠 reset" (:name a))) %)) annotation))))
(spit path (str (json/generate-string result) "\n"))
(let [r (proc/shell {:out :string} "jq" "-S" "." path)] (spit path (:out r)))
(spit doc-path (str "# BOXP-472 パネル対応表\n\n| 元panel id | 元title | row | 区分 | 追加panel id と title | 理由・次の最小対応 |\n|---|---|---|---|---|---|\n" (str/join "\n" @map-lines) "\n"))
